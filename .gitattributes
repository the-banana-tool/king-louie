# Files a Linux or macOS tool reads byte for byte keep LF on every checkout,
# including a Windows clone or export with core.autocrlf=true: visudo rejects
# a sudoers file with CRLF line endings, and a shell script with CRLF fails
# at its first line. The Windows ACL script (*.ps1) is left to the default.
examples/sudoers/* text eol=lf
*.sh text eol=lf
examples/**/*.yaml text eol=lf
examples/**/*.json text eol=lf
examples/**/*.py text eol=lf
# The approval-v1 vectors are compared byte for byte (generate.js --check,
# tests/approvals-protocol.test.js) and read by the phone protocol cores; a
# Windows checkout with core.autocrlf=true must not turn them into CRLF.
tests/vectors/**/*.json text eol=lf
