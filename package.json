{
  "name": "king-louie",
  "version": "26.5.27",
  "description": "Cross-platform Electron desktop chat application",
  "main": "main.js",
  "bin": {
    "king-louie-service": "bin/king-louie-service.js",
    "longhaul": "bin/longhaul.js"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-timeout=120000 tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 tests/e2e/*.test.js",
    "test:watch": "node --test --watch",
    "models:snapshot": "node scripts/models-snapshot.js",
    "smoke:providers": "node scripts/smoke-providers.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "chat",
    "desktop"
  ],
  "author": {
    "name": "Fiscus Technology, LLC",
    "email": "info@fiscus.technology"
  },
  "license": "ISC",
  "build": {
    "appId": "com.kinglouie.app",
    "productName": "King Louie",
    "icon": "icons/icon",
    "files": [
      "**/*",
      "!tests/**",
      "!product-management/**",
      "!.github/**",
      "!src/longhaul/**",
      "!bin/longhaul.js",
      "!examples/**",
      "examples/playbooks/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/!(${platform})/**"
    ],
    "asarUnpack": [
      "examples/playbooks/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@huggingface/transformers": "4.3.0",
    "@mozilla/readability": "^0.6.0",
    "@slack/bolt": "^4.6.0",
    "acme-client": "5.4.0",
    "cron-parser": "^5.5.0",
    "discord.js": "^14.25.1",
    "dompurify": "^3.3.3",
    "electron-store": "^11.0.2",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.11.1",
    "imapflow": "2.0.7",
    "js-yaml": "^4.3.2",
    "linkedom": "^0.18.12",
    "mailparser": "3.9.28",
    "marked": "^17.0.5",
    "nodemailer": "10.0.10",
    "onnxruntime-node": "1.30.0",
    "pdf-lib": "1.17.1",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.2",
    "unpdf": "1.8.1",
    "ws": "8.20.0",
    "xlsx": "^0.18.5"
  }
}
