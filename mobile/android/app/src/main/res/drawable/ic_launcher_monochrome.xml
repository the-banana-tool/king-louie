<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer (Android 13+): the banana and crown of icons/src/icon.svg
     as one flat shape, in the 1024 space of that file, scaled into the 108dp
     adaptive canvas so it sits inside the 66dp safe zone. -->
